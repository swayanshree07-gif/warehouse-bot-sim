<?xml version="1.0"?>
<package format="3">
  <name>warehouse_tasks</name>
  <version>0.1.0</version>
  <description>MoveBox task manager for the Isaac Sim warehouse robot: action server and pick/place state machine.</description>
  <maintainer email="maintainer@example.com">Swayanshree</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>warehouse_interfaces</exec_depend>
  <exec_depend>warehouse_bringup</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>nav2_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
